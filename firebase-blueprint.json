{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and profile details in the system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Report": {
      "title": "Crop Disease Report",
      "description": "Crop health diagnostic reports generated by Gemini AI",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cropName": { "type": "string" },
        "imageUrl": { "type": "string" },
        "diseaseName": { "type": "string" },
        "confidence": { "type": "integer" },
        "severity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "cause": { "type": "string" },
        "symptoms": { "type": "array" },
        "organicTreatment": { "type": "array" },
        "chemicalTreatment": { "type": "array" },
        "medicine": { "type": "string" },
        "dosage": { "type": "string" },
        "estimatedCost": { "type": "string" },
        "safetyPrecautions": { "type": "array" },
        "weatherEffect": { "type": "string" },
        "fertilizer": { "type": "string" },
        "irrigation": { "type": "string" },
        "yieldImpact": { "type": "string" },
        "prevention": { "type": "array" },
        "healthScore": { "type": "integer" },
        "reasoning": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "droneUploaded": { "type": "boolean" },
        "qrCode": { "type": "string" }
      },
      "required": ["userId", "cropName", "imageUrl", "diseaseName", "confidence", "createdAt"]
    },
    "Disease": {
      "title": "Disease Database Entry",
      "description": "Information card of crop diseases for learning center",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "scientificName": { "type": "string" },
        "type": { "type": "string", "enum": ["Fungus", "Virus", "Bacteria", "Pest", "Nutrient Deficiency", "Water Stress", "Temperature", "Humidity"] },
        "symptoms": { "type": "array" },
        "organicTreatment": { "type": "array" },
        "chemicalTreatment": { "type": "array" },
        "prevention": { "type": "array" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "Chat": {
      "title": "AI Farming Assistant Chat",
      "description": "Multi-language chat transcripts with streaming answers",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "language": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "language", "messages", "createdAt"]
    },
    "Calendar": {
      "title": "Crop Calendar Task",
      "description": "Calendar events for farming procedures",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cropName": { "type": "string" },
        "taskType": { "type": "string", "enum": ["Sowing", "Fertilizer", "Irrigation", "Harvest"] },
        "taskName": { "type": "string" },
        "date": { "type": "string" },
        "completed": { "type": "boolean" },
        "notes": { "type": "string" }
      },
      "required": ["userId", "cropName", "taskType", "date", "completed"]
    },
    "Notification": {
      "title": "System Alert Notification",
      "description": "Push alerts for nearby diseases and weather advice",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["disease_alert", "weather_alert", "irrigation_alert"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "read", "createdAt"]
    },
    "FarmRecord": {
      "title": "Farm Activity Record",
      "description": "Farming record log of crops, expenses and yields",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cropName": { "type": "string" },
        "season": { "type": "string" },
        "area": { "type": "string" },
        "sowingDate": { "type": "string" },
        "harvestDate": { "type": "string" },
        "expenses": { "type": "number" },
        "harvestAmount": { "type": "number" },
        "revenue": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "cropName", "createdAt"]
    },
    "CommunityPost": {
      "title": "Community Forum Post",
      "description": "Farmer social sharing posts with optional crop images and AI summarization",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "imageUrl": { "type": "string" },
        "likes": { "type": "array" },
        "aiSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "authorName", "content", "createdAt"]
    },
    "Comment": {
      "title": "Post Comment",
      "description": "Comments attached to community posts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "authorName", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user metadata and configuration"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Diagnostic reports from AI crop checks"
    },
    "/diseases/{diseaseId}": {
      "schema": "Disease",
      "description": "Database of known crop diseases and symptoms"
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Farming assistant chat history sessions"
    },
    "/calendar/{calendarId}": {
      "schema": "Calendar",
      "description": "Crop management tasks on farmer calendar"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "System alerts and notifications for the user"
    },
    "/farmRecords/{recordId}": {
      "schema": "FarmRecord",
      "description": "Historical farming and financial logs"
    },
    "/community/{postId}": {
      "schema": "CommunityPost",
      "description": "Discussion forum posts"
    },
    "/community/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Under-post feedback discussions from community"
    }
  }
}
